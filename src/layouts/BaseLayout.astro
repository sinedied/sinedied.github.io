---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/base.css';
import '../styles/animations.css';
import '../styles/themes/green-phosphor.css';
import '../styles/themes/modern-minimal.css';
import '../styles/themes/cyberpunk-neon.css';
import { ThemeSwitcher } from '../components/theme-switcher.ts';
import { TerminalInput } from '../components/terminal-input.ts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Yohan Lasorsa — Developer Advocate',
  description = 'Developer, speaker, open source enthusiast, and psytrance-powered synth tinkerer. Talks about JavaScript, AI, Cloud, and whatever shiny thing caught my eye.',
  image,
} = Astro.props;

const ogImage = image ? new URL(image, Astro.site ?? Astro.url).href : undefined;

const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'about', path: '/' },
  { href: '/blog/', label: 'blog', path: '/blog' },
  { href: '/projects/', label: 'projects', path: '/projects' },
  { href: '/events/', label: 'events', path: '/events' },
  { href: '/music/', label: 'music', path: '/music' },
];

const pathMap: Record<string, string> = {
  '/': '~',
  '/blog/': '~/blog',
  '/blog': '~/blog',
  '/projects/': '~/projects',
  '/projects': '~/projects',
  '/events/': '~/events',
  '/events': '~/events',
  '/music/': '~/music',
  '/music': '~/music',
  '/man/': '~/help',
  '/man': '~/help',
  '/help/': '~/help',
  '/help': '~/help',
};
const termPath = pathMap[currentPath] || (currentPath.startsWith('/blog/') ? '~/blog' : '~');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Yohan Lasorsa — Blog" href="/rss.xml" />
    <slot name="head" />

    {/* Microsoft Clarity — cookie-free mode for GDPR compliance */}
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "vod7xybu8n");
      clarity("set", "Cookies", ["disable"]);
    </script>

    {/* Blocking script to apply theme before paint — prevents flash */}
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        if (stored) {
          document.documentElement.setAttribute('data-theme', stored);
        } else {
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', prefersDark ? 'modern-minimal' : 'modern-minimal-light');
        }
      })();
    </script>
    <script is:inline>
      (function() {
        if (sessionStorage.getItem('crt-done')) {
          document.documentElement.classList.add('crt-skip');
        } else {
          sessionStorage.setItem('crt-done', '1');
        }
      })();
    </script>
    <script is:inline>
      (function() {
        var p = location.pathname;
        if (p.startsWith('/blog/') && p.split('/').filter(Boolean).length > 1) {
          var rm = localStorage.getItem('reader-mode');
          if (rm === null || rm !== 'false') {
            document.documentElement.setAttribute('data-reader-mode', '');
          }
        }
      })();
    </script>
  </head>

  <body>
    <div class="terminal-window scanline-sweep crt-on">
      <div class="crt-glow" aria-hidden="true"></div>
      {/* Title bar */}
      <div class="titlebar">
        <div class="titlebar-dots">
          <span class="titlebar-dot titlebar-dot--close"></span>
          <span class="titlebar-dot titlebar-dot--minimize"></span>
          <span class="titlebar-dot titlebar-dot--maximize"></span>
        </div>
        <span class="titlebar-title">sinedied<span class="titlebar-title-suffix"> — bash</span></span>
        <ThemeSwitcher client:load />
      </div>

      {/* Navigation */}
      <nav class="terminal-nav">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={(currentPath === item.href || currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path + '/'))) ? 'active' : ''}
          >{item.label}</a>
        ))}
      </nav>

      {/* Content */}
      <main class="terminal-content">
        <slot />
      </main>

      {/* Footer */}
      <footer class="terminal-footer">
        <TerminalInput client:load term-path={termPath} />
      </footer>
    </div>
  </body>
</html>

<style>
  /*
   * Pre-hydration theme-switcher active-button styles.
   * Uses ::part() to pierce Shadow DOM and highlight the correct button
   * based on the data-theme attribute set by the blocking <head> script.
   * Once the component hydrates and sets [ready], internal styles take over.
   */
  html[data-theme="modern-minimal"] theme-switcher:not([ready])::part(btn-modern-minimal),
  html[data-theme="modern-minimal-light"] theme-switcher:not([ready])::part(btn-modern-minimal),
  html[data-theme="cyberpunk-neon"] theme-switcher:not([ready])::part(btn-cyberpunk-neon),
  html[data-theme="green-phosphor"] theme-switcher:not([ready])::part(btn-green-phosphor) {
    color: var(--term-accent, #0f0);
    border-color: var(--term-accent, #0f0);
    background: var(--term-surface-hover, #222);
  }

  /*
   * Icon display custom properties — inherited into Shadow DOM.
   * Controls which sun/moon SVG is visible based on the active theme.
   * For Code themes: explicitly set based on light/dark variant.
   * For other themes: use system preference via media query.
   */
  html[data-theme="modern-minimal"] {
    --ts-sun-display: none;
    --ts-moon-display: inline;
  }
  html[data-theme="modern-minimal-light"] {
    --ts-sun-display: inline;
    --ts-moon-display: none;
  }
  @media (prefers-color-scheme: dark) {
    html[data-theme="cyberpunk-neon"],
    html[data-theme="green-phosphor"] {
      --ts-sun-display: none;
      --ts-moon-display: inline;
    }
  }
  @media (prefers-color-scheme: light) {
    html[data-theme="cyberpunk-neon"],
    html[data-theme="green-phosphor"] {
      --ts-sun-display: inline;
      --ts-moon-display: none;
    }
  }

  .terminal-footer {
    padding: 0.75rem var(--terminal-padding);
    border-top: 1px solid var(--term-border);
    font-size: var(--font-size-sm);
    flex-shrink: 0;
  }
</style>

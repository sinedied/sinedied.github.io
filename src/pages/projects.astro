---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjectsWithGitHubData } from '../lib/github';
import type { SectionKey } from '../lib/github';
import { TypingText } from '../components/typing-text.ts';
import { ProjectCard } from '../components/project-card.ts';

const projects = await getProjectsWithGitHubData();

const sections: { key: SectionKey; label: string; tag?: string }[] = [
  { key: 'featured', label: 'Featured' },
  { key: 'npm', label: 'NPM Packages' },
  { key: 'vscode', label: 'VS Code' },
  { key: 'misc', label: 'Misc' },
  { key: 'legacy', label: 'Legacy', tag: 'unmaintained' },
];
---

<BaseLayout title="Projects — Yohan Lasorsa" description="Open source projects by Yohan Lasorsa">
  <div class="projects-content fade-in fade-in--delay-3">
    {sections.map(({ key, label, tag }, si) => {
      const items = projects.filter((p) => p.section === key);
      if (items.length === 0) return null;
      return (
        <div class={si > 0 ? 'mt-xl' : ''}>
          <div class="section-header">
            {label}
            {tag && <span class="tag">{tag}</span>}
          </div>
          <div class="projects-list">
            {items.map((project, i) => (
              <ProjectCard
                client:load
                class={`fade-in fade-in--delay-${Math.min(i + 1, 7)}`}
                name={project.name}
                slug={project.slug}
                description={project.description}
                stars={project.stars}
                url={project.url}
                language={project.language ?? ''}
                section={project.section}
              />
            ))}
          </div>
        </div>
      );
    })}
  </div>
</BaseLayout>

<style>
  .projects-content {
    margin-top: var(--space-md);
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .tag {
    font-size: var(--font-size-xs, 0.75rem);
    font-weight: 400;
    padding: 1px 6px;
    border-radius: 3px;
    border: 1px solid var(--term-warning, #cc0);
    color: var(--term-warning, #cc0);
    vertical-align: middle;
    margin-left: 0.5rem;
  }
</style>

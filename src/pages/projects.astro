---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjectsWithGitHubData, timeAgo } from '../lib/github';
import { TypingText } from '../components/typing-text.ts';
import { ProjectCard } from '../components/project-card.ts';

const projects = await getProjectsWithGitHubData();
const activeProjects = projects.filter((p) => p.section === 'active');
const legacyProjects = projects.filter((p) => p.section === 'legacy');
---

<BaseLayout title="Projects — Yohan Lasorsa" description="Open source projects by Yohan Lasorsa">
  <div class="prompt-line fade-in">
    <span class="prompt">
      <span class="prompt-user">visitor</span><span class="text-dim">@</span><span class="prompt-path">sinedied</span><span class="prompt-symbol">:~/projects$</span>
    </span>
    <TypingText client:load text="ls -la --sort=stars" speed={35} hide-cursor-on-done />
  </div>

  <div class="projects-content fade-in fade-in--delay-3">
    {/* Active projects */}
    <div class="section-header">Active</div>
    <div class="projects-grid">
      {activeProjects.map((project, i) => (
        <ProjectCard
          client:load
          class={`fade-in fade-in--delay-${Math.min(i + 1, 7)}`}
          name={project.name}
          slug={project.slug}
          description={project.description}
          stars={project.stars}
          last-commit={timeAgo(project.lastCommit)}
          url={project.url}
          language={project.language ?? ''}
          section={project.section}
        />
      ))}
    </div>

    {/* Legacy projects */}
    {legacyProjects.length > 0 && (
      <div class="mt-xl">
        <div class="section-header">Legacy</div>
        <div class="projects-grid">
          {legacyProjects.map((project, i) => (
            <ProjectCard
              client:load
              legacy
              class={`fade-in fade-in--delay-${Math.min(i + 1, 7)}`}
              name={project.name}
              slug={project.slug}
              description={project.description}
              stars={project.stars}
              last-commit={timeAgo(project.lastCommit)}
              url={project.url}
              language={project.language ?? ''}
              section={project.section}
            />
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .prompt-line {
    margin-bottom: var(--space-lg);
    font-size: var(--font-size-md);
  }

  .projects-content {
    margin-top: var(--space-md);
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjectsWithGitHubData } from '../lib/github';
import { TypingText } from '../components/typing-text.ts';
import { ProjectCard } from '../components/project-card.ts';

const projects = await getProjectsWithGitHubData();
const activeProjects = projects.filter((p) => p.section === 'active');
const legacyProjects = projects.filter((p) => p.section === 'legacy');
---

<BaseLayout title="Projects — Yohan Lasorsa" description="Open source projects by Yohan Lasorsa">
  <div class="projects-content fade-in fade-in--delay-3">
    {/* Active projects */}
    <div class="section-header">Active</div>
    <div class="projects-list">
      {activeProjects.map((project, i) => (
        <ProjectCard
          client:load
          class={`fade-in fade-in--delay-${Math.min(i + 1, 7)}`}
          name={project.name}
          slug={project.slug}
          description={project.description}
          stars={project.stars}
          url={project.url}
          language={project.language ?? ''}
          section={project.section}
        />
      ))}
    </div>

    {/* Legacy projects */}
    {legacyProjects.length > 0 && (
      <div class="mt-xl">
        <div class="section-header">Legacy <span class="tag">unmaintained</span></div>
        <div class="projects-list">
          {legacyProjects.map((project, i) => (
            <ProjectCard
              client:load
              legacy
              class={`fade-in fade-in--delay-${Math.min(i + 1, 7)}`}
              name={project.name}
              slug={project.slug}
              description={project.description}
              stars={project.stars}
              url={project.url}
              language={project.language ?? ''}
              section={project.section}
            />
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .projects-content {
    margin-top: var(--space-md);
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .tag {
    font-size: var(--font-size-xs, 0.75rem);
    font-weight: 400;
    padding: 1px 6px;
    border-radius: 3px;
    border: 1px solid var(--term-warning, #cc0);
    color: var(--term-warning, #cc0);
    vertical-align: middle;
    margin-left: 0.5rem;
  }
</style>

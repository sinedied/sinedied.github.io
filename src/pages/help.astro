---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="help — sinedied">
  <div class="man-page fade-in fade-in--delay-3">
    <div class="section-header">TERMINAL(1) — User Commands</div>

    <div class="man-section">
      <div class="man-heading">NAME</div>
      <div class="man-body">terminal — interactive easter egg shell</div>
    </div>

    <div class="man-section">
      <div class="man-heading">SYNOPSIS</div>
      <div class="man-body"><span class="text-accent">command</span> [args...]</div>
    </div>

    <div class="man-section">
      <div class="man-heading">NAVIGATION</div>
      <div class="man-body">
        <div class="man-entry">
          <span class="man-cmd">cd &lt;page&gt;</span>
          <span class="man-desc">Navigate to a page (about, projects, events, ~)</span>
        </div>
        <div class="man-entry">
          <span class="man-cmd">ls</span>
          <span class="man-desc">List available pages</span>
        </div>
        <div class="man-entry">
          <span class="man-cmd">pwd</span>
          <span class="man-desc">Print current directory</span>
        </div>
      </div>
    </div>

    <div class="man-section">
      <div class="man-heading">INFO</div>
      <div class="man-body">
        <div class="man-entry">
          <span class="man-cmd">whoami</span>
          <span class="man-desc">Display current user</span>
        </div>
        <div class="man-entry">
          <span class="man-cmd">man</span>
          <span class="man-desc">Show this manual page</span>
        </div>
        <div class="man-entry">
          <span class="man-cmd">clear</span>
          <span class="man-desc">Clear output and error state</span>
        </div>
        <div class="man-entry">
          <span class="man-cmd">echo &lt;text&gt;</span>
          <span class="man-desc">Echo text back</span>
        </div>
        <div class="man-entry">
          <span class="man-cmd">date</span>
          <span class="man-desc">Display current date and time</span>
        </div>
        <div class="man-entry">
          <span class="man-cmd">uptime</span>
          <span class="man-desc">Show time since page load</span>
        </div>
        <div class="man-entry">
          <span class="man-cmd">uname</span>
          <span class="man-desc">Print system information</span>
        </div>
        <div class="man-entry">
          <span class="man-cmd">hostname</span>
          <span class="man-desc">Print host name</span>
        </div>
        <div class="man-entry">
          <span class="man-cmd">top</span>
          <span class="man-desc">Display running processes</span>
        </div>
      </div>
    </div>

    <div class="man-section">
      <div class="man-heading">DANGEROUS</div>
      <div class="man-body">
        <div class="man-entry">
          <span class="man-cmd">rm &lt;file&gt;</span>
          <span class="man-desc">Remove file</span>
        </div>
        <div class="man-entry">
          <span class="man-cmd">shutdown</span>
          <span class="man-desc">Shutdown the terminal</span>
        </div>
        <div class="man-entry">
          <span class="man-cmd">reboot</span>
          <span class="man-desc">Reboot the terminal</span>
        </div>
        <div class="man-entry">
          <span class="man-cmd">sudo &lt;cmd&gt;</span>
          <span class="man-desc">Run command as admin</span>
        </div>
        <div class="man-entry">
          <span class="man-cmd">exit</span>
          <span class="man-desc">Exit this webpage</span>
        </div>
        <div class="man-entry">
          <span class="man-cmd">matrix</span>
          <span class="man-desc">Follow the white rabbit</span>
        </div>
      </div>
    </div>

    <div class="man-section">
      <div class="man-heading">SHORTCUTS</div>
      <div class="man-body">
        <div class="man-entry">
          <span class="man-cmd">↑ / ↓</span>
          <span class="man-desc">Browse command history</span>
        </div>
        <div class="man-entry">
          <span class="man-cmd">Ctrl+L</span>
          <span class="man-desc">Clear output and error state</span>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .man-page {
    max-width: 640px;
  }

  .man-section {
    margin-bottom: var(--space-lg);
  }

  .man-heading {
    color: var(--term-fg);
    font-weight: 700;
    margin-bottom: var(--space-xs);
  }

  .man-body {
    padding-left: var(--space-lg);
    color: var(--term-dim);
  }

  .man-entry {
    display: flex;
    gap: var(--space-md);
    margin-bottom: var(--space-xs);
    flex-wrap: wrap;
  }

  .man-cmd {
    color: var(--term-accent);
    font-weight: 700;
    min-width: 14ch;
    flex-shrink: 0;
  }

  .man-desc {
    color: var(--term-dim);
  }
</style>

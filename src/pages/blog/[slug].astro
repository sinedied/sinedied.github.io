---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getBlogSlug } from '../../lib/blog';
import { ReaderToggle } from '../../components/reader-toggle.ts';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.published === true);
  return posts.map((post) => ({
    params: { slug: getBlogSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

function estimateReadingTime(body: string): number {
  const words = body.trim().split(/\s+/).length;
  return Math.max(1, Math.round(words / 200));
}

const readingTime = estimateReadingTime(post.body ?? '');
const tags = post.data.tags.split(',').map((t: string) => t.trim()).filter(Boolean);
const canonicalUrl = post.data.canonical_url;
---

<BaseLayout
  title={`${post.data.title} — Yohan Lasorsa`}
  description={post.data.description}
>
  <Fragment slot="head">
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  </Fragment>

  <article class="blog-post fade-in fade-in--delay-3">
    <div class="reader-toggle-wrapper">
      <ReaderToggle client:load />
    </div>

    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-meta">
        <span class="post-date">{formatDate(post.data.date)}</span>
        <span class="meta-sep">·</span>
        <span class="post-reading-time">{readingTime} min read</span>
      </div>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag: string) => (
            <span class="post-tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post {
    margin-top: var(--space-md);
  }

  .reader-toggle-wrapper {
    float: right;
    margin-left: var(--space-md);
  }

  .post-header {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .post-title {
    color: var(--term-accent);
    font-size: var(--font-size-xl);
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: var(--space-sm);
  }

  .post-title::before {
    content: '# ';
    color: var(--term-dim);
  }

  .post-meta {
    color: var(--term-dim);
    font-size: var(--font-size-sm);
    display: flex;
    gap: var(--space-sm);
    align-items: baseline;
    margin-bottom: var(--space-sm);
  }

  .meta-sep {
    color: var(--term-border);
  }

  .post-tags {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .post-tag {
    color: var(--term-dim);
    font-size: var(--font-size-xs);
    border: 1px solid var(--term-border);
    padding: 1px 6px;
    border-radius: 3px;
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { BlogPostItem } from '../../components/blog-post-item.ts';
import { getBlogSlug } from '../../lib/blog';

const posts = (await getCollection('blog', ({ data }) => data.published === true))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<BaseLayout title="Blog — Yohan Lasorsa" description="Blog posts by Yohan Lasorsa about JavaScript, AI, Cloud, and Open Source.">
  <div class="blog-content fade-in fade-in--delay-3">
    <div class="section-header-wrapper">
      <div class="section-header">Blog</div>
      <a href="/rss.xml" class="rss-link" target="_blank" rel="noopener noreferrer" title="RSS Feed">⟨rss/⟩</a>
    </div>

    <div id="tag-filter" class="tag-filter" style="display:none;">
      <span class="text-dim">Filtered by tag:</span>
      <span id="tag-filter-name" class="tag-active"></span>
      <a id="tag-filter-clear" href="/blog/" class="tag-clear" title="Clear filter">✕</a>
    </div>

    {posts.length === 0 ? (
      <p class="text-dim">No posts yet. Check back soon!</p>
    ) : (
      <div class="post-list">
        {posts.map((post, i) => (
          <BlogPostItem
            client:load
            class={`fade-in fade-in--delay-${Math.min(i + 1, 7)}`}
            date={formatDate(post.data.date)}
            title={post.data.title}
            href={`/blog/${getBlogSlug(post)}/`}
            tags={post.data.tags}
            data-tags={post.data.tags.split(',').map((t: string) => t.trim().toLowerCase()).join(',')}
          />
        ))}
      </div>
    )}

    <p id="no-results" class="text-dim" style="display:none;padding-left:var(--space-sm);">No posts matching this tag.</p>
  </div>
</BaseLayout>

<script is:inline>
  (function filterByTag() {
    const params = new URLSearchParams(window.location.search);
    const tag = params.get('tag');
    if (!tag) return;

    const filterEl = document.getElementById('tag-filter');
    const filterName = document.getElementById('tag-filter-name');
    const noResults = document.getElementById('no-results');
    if (filterEl) filterEl.style.display = '';
    if (filterName) filterName.textContent = tag;

    const items = document.querySelectorAll('.post-list blog-post-item');
    let visible = 0;
    items.forEach((item) => {
      const tags = (item.getAttribute('data-tags') || '').split(',');
      if (tags.includes(tag.toLowerCase())) {
        item.style.display = '';
        visible++;
      } else {
        item.style.display = 'none';
      }
    });

    if (visible === 0 && noResults) noResults.style.display = '';
  })();
</script>

<style>
  .blog-content {
    margin-top: var(--space-md);
  }

  .post-list {
    padding-left: var(--space-sm);
  }

  .tag-filter {
    display: flex;
    align-items: center;
    gap: var(--space-sm, 0.5rem);
    margin-bottom: var(--space-sm, 0.5rem);
    font-size: var(--font-size-sm, 0.85rem);
    padding-left: var(--space-sm);
  }

  .tag-active {
    color: var(--term-accent);
    border: 1px solid var(--term-accent);
    padding: 1px 6px;
    border-radius: 3px;
    font-size: var(--font-size-xs, 0.75rem);
  }

  .tag-clear {
    color: var(--term-dim);
    text-decoration: none;
    font-size: var(--font-size-sm, 0.85rem);
    transition: color 0.2s;
  }

  .tag-clear:hover {
    color: var(--term-accent);
  }

  .section-header-wrapper {
    position: relative;
  }

  .section-header-wrapper .section-header {
    margin-bottom: var(--space-lg);
  }

  .rss-link {
    position: absolute;
    right: 0;
    top: 0.4em;
    font-size: var(--font-size-sm, 0.85rem);
    color: var(--term-dim);
    text-decoration: none;
    font-weight: 400;
    transition: color 0.2s;
  }

  .rss-link:hover {
    color: var(--term-accent);
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, socialIcons, type SocialKey } from '../lib/config';
import { TypingText } from '../components/typing-text.ts';

const socialEntries = Object.entries(siteConfig.social) as [SocialKey, string][];
---

<BaseLayout>
  <div class="home-content fade-in fade-in--delay-3">
    <div class="section-header">About me</div>

    {/* Info block */}
    <div class="about-row">
      <img
        class="profile-pic"
        src="https://github.com/sinedied.png"
        alt="Yohan Lasorsa"
        width="120"
        height="120"
        loading="eager"
      />
      <div class="info">
      <div class="info-line">
        <span class="info-key">Name:</span>
        <span>{siteConfig.name}</span>
      </div>
      <div class="info-line">
        <span class="info-key">Role:</span>
        <span>{siteConfig.role} @ {siteConfig.company}</span>
      </div>
      <div class="info-line">
        <span class="info-key">Focus:</span>
        <span>JavaScript, AI, Cloud, Open Source</span>
      </div>
      <div class="info-line">
        <span class="info-key">Languages:</span>
        <span>TypeScript/JavaScript, Python, C#, C/C++</span>
      </div>
      <div class="info-line">
        <span class="info-key">Interests:</span>
        <span>{siteConfig.bio}</span>
      </div>
      </div>
    </div>

    {/* Social links */}
    <div class="social-section">
      <div class="section-header">Socials</div>
      <div class="social-links">
        {socialEntries.map(([key, url]) => (
          <a
            class="social-link"
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={key}
          >
            <span class="social-icon" set:html={socialIcons[key]}></span>
            <span class="social-name">{key}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .home-content {
    margin-top: var(--space-md);
  }

  /* ── Info ───────────────────────────────── */
  .about-row {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
    margin-bottom: var(--space-2xl);
  }

  .profile-pic {
    border-radius: 50%;
    border: 2px solid var(--term-border);
    flex-shrink: 0;
    opacity: 0.9;
  }

  .info {
  }

  .info-line {
    line-height: 1.7;
  }

  .info-key {
    color: var(--term-accent);
    font-weight: 700;
    margin-right: 0.5rem;
    min-width: 6rem;
    display: inline-block;
  }

  /* ── Social Links ──────────────────────── */
  .social-section {
    margin-top: var(--space-xl);
  }

  .social-links {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) 0;
    color: var(--term-fg);
    text-decoration: none;
    transition: color 0.2s, text-shadow 0.2s;
    font-size: var(--font-size-sm);
  }

  .social-link:hover {
    color: var(--term-accent);
  }

  .social-link:hover .social-icon {
    color: var(--term-accent);
  }

  .social-icon {
    color: var(--term-dim);
    display: inline-flex;
    align-items: center;
    transition: color 0.2s;
  }

  .social-name {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--term-border);
  }

  .social-link:hover .social-name {
    text-decoration-color: var(--term-accent);
  }

  /* ── Responsive ────────────────────────── */
  @media (max-width: 640px) {
    .about-row {
      flex-direction: column;
      align-items: center;
    }

    .profile-pic {
      width: 80px;
      height: 80px;
    }

    .info-key {
      min-width: auto;
      display: block;
    }

    .social-links {
      flex-direction: column;
      gap: var(--space-xs);
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, socialIcons, type SocialKey } from '../lib/config';
import { BootSequence } from '../components/boot-sequence.ts';
import { TypingText } from '../components/typing-text.ts';

const socialEntries = Object.entries(siteConfig.social) as [SocialKey, string][];
---

<BaseLayout>
  <BootSequence client:load />

  <div class="home-content fade-in fade-in--delay-3">
    {/* Neofetch-style display */}
    <div class="neofetch">
      <pre class="ascii-art" aria-hidden="true">{`
   ┌─────────────────────┐
   │  ┌──┐  ┌──┐  ┌──┐  │
   │  │▓▓│  │▓▓│  │▓▓│  │
   │  └──┘  └──┘  └──┘  │
   │   ┌──────────────┐  │
   │   │ > _          │  │
   │   │              │  │
   │   └──────────────┘  │
   └─────────────────────┘
      `}</pre>
      <div class="info">
        <div class="info-line">
          <span class="info-label">visitor</span><span class="text-dim">@</span><span class="text-accent">sinedied</span>
        </div>
        <div class="info-separator">──────────────────────</div>
        <div class="info-line">
          <span class="info-key">Name:</span>
          <span>{siteConfig.name}</span>
        </div>
        <div class="info-line">
          <span class="info-key">Role:</span>
          <span>{siteConfig.role} @ {siteConfig.company}</span>
        </div>
        <div class="info-line">
          <span class="info-key">Focus:</span>
          <span>JavaScript, AI, Cloud, Open Source</span>
        </div>
        <div class="info-line">
          <span class="info-key">OS:</span>
          <span>Web Platform</span>
        </div>
        <div class="info-line">
          <span class="info-key">Shell:</span>
          <span>bash 5.2</span>
        </div>
        <div class="info-line">
          <span class="info-key">Langs:</span>
          <span>TypeScript, JavaScript, Python, C#</span>
        </div>
        <div class="info-line">
          <span class="info-key">Interests:</span>
          <span>{siteConfig.bio}</span>
        </div>
      </div>
    </div>

    {/* Social links */}
    <div class="social-section">
      <div class="section-header">Links</div>
      <div class="social-links">
        {socialEntries.map(([key, url]) => (
          <a
            class="social-link"
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={key}
          >
            <span class="prompt-symbol">$</span>
            <span class="text-dim">open</span>
            <span class="social-icon" set:html={socialIcons[key]}></span>
            <span class="social-name">{key}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .home-content {
    margin-top: var(--space-md);
  }

  /* ── Neofetch ──────────────────────────── */
  .neofetch {
    display: flex;
    gap: var(--space-xl);
    align-items: flex-start;
    margin-bottom: var(--space-2xl);
  }

  .ascii-art {
    color: var(--term-accent);
    font-size: var(--font-size-sm);
    line-height: 1.3;
    flex-shrink: 0;
    user-select: none;
  }

  .info {
    flex: 1;
    min-width: 0;
  }

  .info-line {
    line-height: 1.7;
  }

  .info-label {
    color: var(--term-fg);
    font-weight: 700;
  }

  .info-key {
    color: var(--term-accent);
    font-weight: 700;
    margin-right: 0.5rem;
    min-width: 6rem;
    display: inline-block;
  }

  .info-separator {
    color: var(--term-border);
    margin: var(--space-xs) 0;
  }

  /* ── Social Links ──────────────────────── */
  .social-section {
    margin-top: var(--space-xl);
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) 0;
    color: var(--term-fg);
    text-decoration: none;
    transition: color 0.2s, text-shadow 0.2s;
    font-size: var(--font-size-sm);
  }

  .social-link:hover {
    color: var(--term-accent);
  }

  .social-link:hover .social-icon {
    color: var(--term-accent);
  }

  .social-icon {
    color: var(--term-dim);
    display: inline-flex;
    align-items: center;
    transition: color 0.2s;
  }

  .social-name {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--term-border);
  }

  .social-link:hover .social-name {
    text-decoration-color: var(--term-accent);
  }

  .prompt-symbol {
    color: var(--term-accent);
    font-weight: 700;
  }

  /* ── Responsive ────────────────────────── */
  @media (max-width: 640px) {
    .neofetch {
      flex-direction: column;
      gap: var(--space-md);
    }

    .ascii-art {
      font-size: var(--font-size-xs);
    }

    .info-key {
      min-width: auto;
      display: block;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, socialIcons, type SocialKey } from '../lib/config';
import { TypingText } from '../components/typing-text.ts';
import { BlogPostItem } from '../components/blog-post-item.ts';
import { getCollection } from 'astro:content';
import { getBlogSlug } from '../lib/blog';

const socialEntries = Object.entries(siteConfig.social) as [SocialKey, string][];

const recentPosts = (await getCollection('blog', ({ data }) => data.published === true))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<BaseLayout>
  <div class="home-content fade-in fade-in--delay-3">
    <div class="section-header">Hello, world!</div>

    {/* Info block */}
    <div class="about-row">
      <img
        class="profile-pic"
        src="https://github.com/sinedied.png"
        alt="Yohan Lasorsa"
        width="120"
        height="120"
        loading="eager"
      />
      <div class="info">
      <div class="info-line">
        <span class="info-key">Name:</span>
        <span>{siteConfig.name}</span>
      </div>
      <div class="info-line">
        <span class="info-key">Role:</span>
        <span>{siteConfig.role} @ {siteConfig.company}</span>
      </div>
      <div class="info-line">
        <span class="info-key">Focus:</span>
        <span>JavaScript, AI, Cloud, Open Source</span>
      </div>
      <div class="info-line">
        <span class="info-key">Languages:</span>
        <span>TypeScript/JavaScript, Python, C#, C/C++</span>
      </div>
      <div class="info-line">
        <span class="info-key">Interests:</span>
        <span>{siteConfig.bio}</span>
      </div>
      </div>
    </div>

    <div class="intro-blurb">
      <p>Coder by trade, tinkerer by nature. If it can be built, I'll probably try.</p>
      <p>I craft open-source tools, mass-produce NPM packages, and occasionally escape the terminal to produce electronic music, shred some powder, or hike a mountain.</p>
      <p>Based in Grenoble, France. Surrounded by the Alps and fueled by good cheese.</p>
    </div>

    {/* Social links */}
    <div class="social-section">
      <div class="section-header">Socials</div>
      <div class="social-links">
        {socialEntries.map(([key, url]) => (
          <a
            class="social-link"
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={key}
          >
            <span class="social-icon" set:html={socialIcons[key]}></span>
            <span class="social-name">{key}</span>
          </a>
        ))}
      </div>
    </div>

    {/* Recent blog posts */}
    {recentPosts.length > 0 && (
      <div class="recent-posts-section">
        <div class="section-header">Recent Posts</div>
        <div class="recent-posts">
          {recentPosts.map((post, i) => (
            <BlogPostItem
              client:load
              class={`fade-in fade-in--delay-${Math.min(i + 1, 7)}`}
              date={formatDate(post.data.date)}
              title={post.data.title}
              href={`/blog/${getBlogSlug(post)}/`}
              tags={post.data.tags}
              description={post.data.description}
            />
          ))}
        </div>
        <a class="view-all-link" href="/blog/">View all posts &rarr;</a>
      </div>
    )}

  </div>
</BaseLayout>

<style>
  .home-content {
    margin-top: var(--space-md);
  }

  /* ── Intro blurb ────────────────────────── */
  .intro-blurb {
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .intro-blurb p {
    margin: 0 0 var(--space-xs) 0;
  }

  /* ── Info ───────────────────────────────── */
  .about-row {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
    margin-bottom: var(--space-2xl);
  }

  .profile-pic {
    border-radius: 50%;
    border: 2px solid var(--term-border);
    flex-shrink: 0;
    opacity: 0.9;
  }

  .info {
  }

  .info-line {
    line-height: 1.7;
  }

  .info-key {
    color: var(--term-accent);
    font-weight: 700;
    margin-right: 0.5rem;
    min-width: 6rem;
    display: inline-block;
  }

  /* ── Social Links ──────────────────────── */
  .social-section {
    margin-top: var(--space-xl);
  }

  .social-links {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) 0;
    color: var(--term-fg);
    text-decoration: none;
    transition: color 0.2s, text-shadow 0.2s;
    font-size: var(--font-size-sm);
  }

  .social-link:hover {
    color: var(--term-accent);
  }

  .social-link:hover .social-icon {
    color: var(--term-accent);
  }

  .social-icon {
    color: var(--term-dim);
    display: inline-flex;
    align-items: center;
    transition: color 0.2s;
  }

  .social-name {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--term-border);
  }

  .social-link:hover .social-name {
    text-decoration-color: var(--term-accent);
  }

  /* ── Responsive ────────────────────────── */
  @media (max-width: 640px) {
    .about-row {
      flex-direction: column;
      align-items: center;
    }

    .info {
      width: 100%;
    }

    .profile-pic {
      width: 80px;
      height: 80px;
    }

    .info-key {
      min-width: auto;
    }

    .social-links {
      gap: var(--space-xs) var(--space-sm);
    }
  }

  /* ── Recent Posts ──────────────────────── */
  .recent-posts-section {
    margin-top: var(--space-xl);
  }

  .recent-posts {
    padding-left: var(--space-sm);
  }

  .view-all-link {
    display: inline-block;
    margin-top: var(--space-md);
    color: var(--term-dim);
    font-size: var(--font-size-sm);
    text-decoration: none;
    transition: color 0.2s;
  }

  .view-all-link:hover {
    color: var(--term-accent);
    text-shadow: none;
  }
</style>

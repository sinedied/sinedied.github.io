---
import BaseLayout from '../layouts/BaseLayout.astro';
import { socialIcons } from '../lib/config';
import { fetchLatestVideo } from '../lib/youtube';

const latestVideo = await fetchLatestVideo();
---

<BaseLayout title="Music — Yohan Lasorsa" description="Psytrance & electronic music by Sine Die (Yohan Lasorsa), released on Hadra Records.">
  <div class="music-content fade-in fade-in--delay-3">
    <div class="section-header">Music</div>
    <p class="music-blurb">
      I produce psytrance &amp; electronic music under the name <strong>Sine Die</strong>,
      released on <a href="https://hadrarecords.bandcamp.com/music" target="_blank" rel="noopener noreferrer">Hadra Records</a>.
    </p>
    <div class="music-links">
      <a class="music-link" href="https://www.youtube.com/@sinediemusic" target="_blank" rel="noopener noreferrer">
        <span class="music-icon" set:html={socialIcons.youtube}></span>
        <span class="music-name">YouTube</span>
      </a>
      <a class="music-link" href="https://open.spotify.com/artist/53ikKKG2MxLq7TuZUB7G29" target="_blank" rel="noopener noreferrer">
        <span class="music-icon">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
        </span>
        <span class="music-name">Spotify</span>
      </a>
    </div>
    {latestVideo && (
      <div class="music-player">
        <div class="player-label">Latest video</div>
        <div class="video-container">
          <iframe
            src={`https://www.youtube.com/embed/${latestVideo.id}`}
            title={latestVideo.title}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        <div class="video-title">{latestVideo.title}</div>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .music-content {
    margin-top: var(--space-md);
  }

  .music-blurb {
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }

  .music-blurb strong {
    color: var(--term-accent);
  }

  .music-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .music-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) 0;
    color: var(--term-fg);
    text-decoration: none;
    transition: color 0.2s, text-shadow 0.2s;
    font-size: var(--font-size-sm);
  }

  .music-link:hover {
    color: var(--term-accent);
  }

  .music-link:hover .music-icon {
    color: var(--term-accent);
  }

  .music-icon {
    color: var(--term-dim);
    display: inline-flex;
    align-items: center;
    transition: color 0.2s;
  }

  .music-name {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--term-border);
  }

  .music-link:hover .music-name {
    text-decoration-color: var(--term-accent);
  }

  .music-player {
    margin-top: var(--space-sm);
  }

  .player-label {
    font-size: var(--font-size-sm);
    color: var(--term-dim);
    margin-bottom: var(--space-sm);
  }

  .video-container {
    position: relative;
    width: 100%;
    max-width: 560px;
    padding-bottom: min(315px, 56.25%);
    height: 0;
    overflow: hidden;
    border: 1px solid var(--term-border);
    border-radius: 4px;
  }

  .video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .video-title {
    margin-top: var(--space-sm);
    font-size: var(--font-size-sm);
    color: var(--term-dim);
  }
</style>
